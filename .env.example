# Sachivalayam Citizen Portal - Production Environment Variables

# Cryptographic Secret Key for session cookies (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key

# Admin User Setup
ADMIN_EMAIL=admin@sachivalayam.gov.in
